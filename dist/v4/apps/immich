{"captainVersion":4,"services":{"$$cap_appname":{"caproverExtra":{"containerHttpPort":2283},"image":"ghcr.io/immich-app/immich-server:$$cap_version","ports":["2283:2283"],"environment":{"DB_PASSWORD":"$$cap_app_db_pass","DB_USERNAME":"$$cap_app_db_user","DB_DATABASE_NAME":"$$cap_app_db_name","DB_HOSTNAME":"srv-captain--$$cap_appname-db","REDIS_HOSTNAME":"srv-captain--$$cap_appname-redis","UPLOAD_LOCATION":"/data","IMMICH_MACHINE_LEARNING_URL":"http://srv-captain--$$cap_appname-machine-learning:3003","IMMICH_LOG_LEVEL":"log","DB_SKIP_MIGRATIONS":"false","IMMICH_API_METRICS_PORT":8081,"IMMICH_MICROSERVICES_METRICS_PORT":8082,"IMMICH_TELEMETRY_INCLUDE":"all"},"volumes":["$$cap_app_media_root:/data","/etc/localtime:/etc/localtime:ro"],"depends_on":["$$cap_appname-redis","$$cap_appname-db","$$cap_appname-machine-learning"],"serviceUpdateOverride":"{ \"TaskTemplate\": { \"RestartPolicy\": { \"Condition\": \"none\", \"MaxAttempts\": 0 } } }\n"},"$$cap_appname-machine-learning":{"caproverExtra":{"notExposeAsWebApp":"true"},"image":"ghcr.io/immich-app/immich-machine-learning:$$cap_version","environment":{"DB_PASSWORD":"$$cap_app_db_pass","DB_USERNAME":"$$cap_app_db_user","DB_DATABASE_NAME":"$$cap_app_db_name","DB_HOSTNAME":"srv-captain--$$cap_appname-db","REDIS_HOSTNAME":"srv-captain--$$cap_appname-redis","UPLOAD_LOCATION":"$$cap_app_media_root"},"volumes":["$$cap_appname-model-cache:/cache"]},"$$cap_appname-redis":{"caproverExtra":{"notExposeAsWebApp":"true"},"image":"$$cap_redis_image"},"$$cap_appname-db":{"caproverExtra":{"notExposeAsWebApp":"true"},"image":"$$cap_postgres_image","environment":{"POSTGRES_PASSWORD":"$$cap_app_db_pass","POSTGRES_USER":"$$cap_app_db_user","POSTGRES_DB":"$$cap_app_db_name","POSTGRES_INITDB_ARGS":"--data-checksums","PG_DATA":"/var/lib/postgresql/data"},"volumes":["$$cap_appname-db-data:/var/lib/postgresql/data"]},"$$cap_appname-prometheus-init":{"caproverExtra":{"notExposeAsWebApp":"true"},"image":"alpine:3","command":["/bin/sh","-c","mkdir -p /mnt/prometheus\ncat > /mnt/prometheus/prometheus.yml <<'EOF'\nglobal:\nscrape_interval:     15s\nevaluation_interval: 15s\n\nscrape_configs:\n- job_name: immich_api\n    static_configs:\n    - targets: ['srv-captain--$$cap_appname:8081']\n\n- job_name: immich_microservices\n    static_configs:\n    - targets: ['srv-captain--$$cap_appname:8082']\nEOF\nsleep 10\n"],"volumes":["$$cap_appname-prometheus-config:/mnt/prometheus"]},"$$cap_appname-prometheus":{"caproverExtra":{"notExposeAsWebApp":"true","containerHttpPort":9090},"image":"$$cap_prometheus_image","ports":["9090:9090"],"volumes":["$$cap_appname-prometheus-config:/etc/prometheus","$$cap_appname-prometheus-data:/prometheus"],"depends_on":["$$cap_appname-prometheus-init"]},"$$cap_appname-grafana-init":{"image":"alpine:3","caproverExtra":{"notExposeAsWebApp":"true"},"command":["/bin/sh","-c","mkdir -p /mnt/grafana/provisioning/datasources\nmkdir -p /mnt/grafana/provisioning/dashboards\nmkdir -p /mnt/grafana/dashboards\n\n# Write Prometheus datasource provisioning\ncat > /mnt/grafana/provisioning/datasources/datasource.yaml <<'EOF'\napiVersion: 1\ndatasources:\n  - name: Prometheus\n    type: prometheus\n    access: proxy\n    url: http://srv-captain--$$cap_appname-prometheus:9090\n    isDefault: true\nEOF\n\n# Write dashboards provisioning config\ncat > /mnt/grafana/provisioning/dashboards/immich-overview.yaml <<'EOF'\napiVersion: 1\nproviders:\n  - name: 'immich-overview'\n    orgId: 1\n    folder: ''\n    type: file\n    disableDeletion: false\n    updateIntervalSeconds: 10\n    options:\n      path: /var/lib/grafana/dashboards\nEOF\n\n# Download Immich Overview dashboard JSON\nwget -O /mnt/grafana/dashboards/immich-overview.json https://grafana.com/api/dashboards/22555/revisions/1/download\n\nsleep 10\n"],"volumes":["$$cap_appname-grafana-config:/mnt/grafana"]},"$$cap_appname-grafana":{"image":"$$cap_grafana_image","restart":"always","caproverExtra":{"notExposeAsWebApp":"true","containerHttpPort":3000},"depends_on":["$$cap_appname-grafana-init"],"ports":["3001:3000"],"volumes":["$$cap_appname-grafana-config:/etc/grafana","$$cap_appname-grafana-data:/var/lib/grafana"]}},"volumes":{"$$cap_app_media_root":null,"$$cap_appname-model-cache":null,"$$cap_appname-db-data":null,"$$cap_appname-prometheus-config":null,"$$cap_appname-prometheus-data":null,"$$cap_appname-grafana-config":null,"$$cap_appname-grafana-data":null},"caproverOneClickApp":{"displayName":"Immich 1.39.2+","description":"Open source (AGPLv3) Google Photos alternative with Prometheus and Grafana. Backup your photos and videos to your own server.","isOfficial":false,"documentation":"https://immich.app","instructions":{"start":"Leave every default value as is for a working and simple installation.\nYou can specify the (full) path to the directory you want to save your media at. The directory must exist beforehand. Immich can be used from a browser but typically requires you to install the Immich app on your phone.\nIf you have big media files (bigger than 500MB) that you want to backup, update your Nginx configuration file in CapRover to increase your `client_max_body_size` value, otherwise uploads will fail.\n\nPrometheus & Grafana:\n- Prometheus and Grafana are included for observability and metrics.\n- Visit Prometheus (port 9090) or Grafana (port 3001) from your CapRover dashboard.\n- Grafana connects to Prometheus at: `http://srv-captain--$$cap_appname-prometheus:9090`.\n- To see raw service metrics, you can expose metrics ports by uncommenting the relevant `ports:` and environment variables for Immich services:\n- More about env variables at https://immich.app/docs/install/environment-variables/#general\n- Then visit `/metrics` on those ports.\n\nPrometheus configuration:\n- Prometheus config file (`prometheus.yml`) is injected on first deploy and persisted. To update it, edit the Prometheus config variable and redeploy. After the first deploy, you can safely remove the `prometheus-init` service.\n\nGPU Support:\n- If your server has a compatible Nvidia GPU, enable machine learning acceleration by using the `-cuda` image tag and uncommenting the relevant deploy block.\n- Your host must have Nvidia drivers and the Docker GPU runtime enabled.\n\nVolumes & Data:\n- Upload directory, database, Prometheus, and Grafana all use named volumes.\n- If you change a volume path or a related environment variable (like `PG_DATA`), make sure they match exactly. Changing one without the other may cause data loss or misconfiguration.","end":"On your first visit it will ask for email and password to set up the admin user.\nRemember to change the default Nginx configuration and increase the `client_max_body_size` value if you expect to backup files bigger than 500MB, otherwise uploads will fail.\n\nSome upgrades take more and to preempt a restart go to **App Configs** and for now **Service Update Override** was preconfigured: `{ \"TaskTemplate\": { \"RestartPolicy\": { \"Condition\": \"none\", \"MaxAttempts\": \"0\" } } }`\n\nPrometheus and Grafana dashboards are available after deploy (ports 9090 and 3001).\nGrafana persists dashboards and Prometheus collects metrics from Immich and related services as configured."},"variables":[{"label":"Immich version","id":"$$cap_version","description":"Check out their valid tags at https://github.com/immich-app/immich/releases","defaultValue":"v1.139.2"},{"label":"Immich Redis (Valkey) image","id":"$$cap_redis_image","description":"Full image ref (with tag or digest) for Redis/Valkey. Default matches latest compose.","defaultValue":"docker.io/valkey/valkey:8-bookworm@sha256:a137a2b60aca1a75130022d6bb96af423fefae4eb55faf395732db3544803280"},{"label":"Immich Postgres image","id":"$$cap_postgres_image","description":"Full image ref (with tag or digest) for the Immich-optimized Postgres. See https://github.com/immich-app/immich/releases for valid versions.","defaultValue":"ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:32324a2f41df5de9efe1af166b7008c3f55646f8d0e00d9550c16c9822366b4a"},{"label":"Grafana image","id":"$$cap_grafana_image","description":"Find versions on DockerHub https://hub.docker.com/r/grafana/grafana/tags","defaultValue":"grafana/grafana:12.1"},{"label":"Prometheus image","id":"$$cap_prometheus_image","description":"Find versions on DockerHub https://hub.docker.com/r/prom/prometheus/tags","defaultValue":"prom/prometheus:v3.5.0"},{"label":"Database password","id":"$$cap_app_db_pass","description":"Password for accessing the database. A random one has been generated for you.","defaultValue":"$$cap_gen_random_hex(32)"},{"label":"Database username","id":"$$cap_app_db_user","description":"Username to access the database","defaultValue":"immich"},{"label":"Database name","id":"$$cap_app_db_name","description":"A name for the database used by Immich","defaultValue":"immich"},{"label":"Media root (legacy \"upload\" directory)","id":"$$cap_app_media_root","description":"Absolute host path where all Immich media will be stored (photos, videos, thumbnails, etc). Create this directory beforehand, or leave as default for a Docker-managed volume. If value is absolute (starts with /), it's a host directory; if relative, it's a persistent Docker volume managed by CapRover/Swarm.","defaultValue":"immich-data"}]}}
